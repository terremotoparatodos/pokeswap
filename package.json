{
  "name": "pokeswap",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src/",
    "catalog:fetch": "node scripts/battle-catalog/fetch.mjs",
    "catalog:build": "node scripts/battle-catalog/build.mjs",
    "catalog:sample": "node scripts/battle-catalog/sample.mjs",
    "pokemon:sample": "vite-node scripts/pokemon-sample.ts --",
    "battle:sample": "vite-node scripts/battle-sample.ts --",
    "dungeon:entrances": "vite-node scripts/dungeon-entrances.ts --",
    "benchmark:multiplayer": "node scripts/benchmark-presence.mjs"
  },
  "dependencies": {
    "@colyseus/sdk": "^0.18.2",
    "@supabase/supabase-js": "^2.49.0",
    "vue": "^3.5.0",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/test-utils": "^2.4.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-vue": "^9.30.0",
    "globals": "^15.0.0",
    "jsdom": "^25.0.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.2.0",
    "vitest": "^3.0.0",
    "vue-tsc": "^2.2.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
