+// CLOUD JOIN-ORDER-1 PROTOTYPE — ordering the connection attempts of ONE page of ONE account.
+//
+// Contract (docs/design/CLOUD_JOIN_ORDER_1_PROPOSAL.md):
+//   - page    = the client's per-page-load id (today's tabId). Never a credential: it only orders
+//               the attempts of the SAME authenticated user; forging it can only hurt that user.
+//   - attempt = a positive integer the page increments on EVERY new join it opens (first join,
+//               automatic reconnection, renewed session, «Jugar acá»). A join is never re-sent with
+//               the same attempt: a repeated (page, attempt) is a duplicate, never a retry.
+//   - in ONE process: an attempt at or below the highest one this process already admitted for that
+//               (user, page) is refused at admission (4410 stale-attempt), checked in the synchronous
+//               tail of admission and again right before the room replaces the previous socket. The
+//               live socket is never closed for it.
+//   - across processes: the same order is enforced by the location claim (claim v3, SQL); a process
+//               only knows its own history, so memory alone never proves global order.
+// Mode WORLD_JOIN_ORDER: off (today's behaviour) | shadow (count, admit as today) | on (enforce).
+
+export const JOIN_ORDER_ENV = 'WORLD_JOIN_ORDER'
+export const ATTEMPT_MAX = 2 ** 31 - 1
+export const STALE_ATTEMPT_CODE = 4410
+export const INVALID_ATTEMPT_CODE = 4422
+export const joinOrderMode = env => (env?.[JOIN_ORDER_ENV] === 'on' || env?.[JOIN_ORDER_ENV] === 'shadow' ? env[JOIN_ORDER_ENV] : 'off')
+
+export class InvalidAttempt extends Error {}
+
+/** The attempt a join declares: null (a client that does not send one) or a valid integer; anything else throws. */
+export function attemptOf(options) {
+  if (options?.attempt === undefined) return null
+  const attempt = options.attempt
+  if (!Number.isSafeInteger(attempt) || attempt < 1 || attempt > ATTEMPT_MAX) throw new InvalidAttempt('invalid attempt')
+  return attempt
+}
+
+export class JoinOrder {
+  constructor({ mode = 'off', maxPages = 10_000 } = {}) {
+    this.mode = mode
+    this.maxPages = maxPages
+    /** `${userId}\n${page}` → highest attempt admitted here. Insertion order = recency (bounded LRU). */
+    this.highest = new Map()
+    this.counters = { admitted: 0, stale: 0, duplicate: 0, invalid: 0, legacy: 0, evicted: 0, wouldRefuse: 0 }
+  }
+
+  /**
+   * At admission, synchronously (after every await of the admission): 'admit' | 'stale' | 'duplicate'.
+   * Only an admitted attempt raises the page's high-water mark; a refused one changes nothing.
+   */
+  observe(userId, page, attempt) {
+    const key = `${userId}\n${page}`
+    const highest = this.highest.get(key)
+    if (highest !== undefined && attempt <= highest) {
+      this.counters[attempt === highest ? 'duplicate' : 'stale']++
+      return attempt === highest ? 'duplicate' : 'stale'
+    }
+    this.highest.delete(key)
+    this.highest.set(key, attempt)
+    this.counters.admitted++
+    while (this.highest.size > this.maxPages) { this.highest.delete(this.highest.keys().next().value); this.counters.evicted++ }
+    return 'admit'
+  }
+
+  /** Right before the room replaces a socket: is `attempt` still the highest this process admitted for the page? */
+  isLatest(userId, page, attempt) {
+    return this.highest.get(`${userId}\n${page}`) === attempt
+  }
+
+  stats() { return { mode: this.mode, pages: this.highest.size, ...this.counters } }
+}
