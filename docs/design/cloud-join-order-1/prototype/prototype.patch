+        if (missingFunction(error)) throw new RecoveryUnsupported('sql-missing')
+        throw error
+      }
+    },
+    async presenceAnyActive() {
+      try { return (await query('SELECT public.world_presence_any_active() AS r', [])).rows[0]?.r === true } catch (error) {
