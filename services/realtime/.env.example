SUPABASE_URL=https://your-project.supabase.co
# Clave publishable/anon; nunca service-role ni JWT secret.
SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
ALLOWED_ORIGINS=http://localhost:5173
# WORLD LOCATION-2: off (default) | shadow | on. Needs the world-authority adapter
# (WORLD_AUTHORITY_URL + WORLD_AUTHORITY_SECRET) with location_claim/location_save deployed.
WORLD_LOCATION_PERSISTENCE=off
